{
  "name": "commit-hike",
  "displayName": "Commit Hike",
  "description": "Your commits move you along a hiking trail. Local-only, never touches your repositories.",
  "version": "0.1.0",
  "publisher": "commit-hike",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "extensionDependencies": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "commitHike",
          "title": "Commit Hike",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "commitHike": [
        {
          "type": "webview",
          "id": "commitHike.trail",
          "name": "Trail"
        }
      ]
    },
    "commands": [
      {
        "command": "commitHike.showTrail",
        "title": "Show Trail",
        "category": "Commit Hike"
      },
      {
        "command": "commitHike.setup",
        "title": "Set Up",
        "category": "Commit Hike"
      },
      {
        "command": "commitHike.chooseRoute",
        "title": "Choose Trail for All Projects",
        "category": "Commit Hike"
      },
      {
        "command": "commitHike.chooseProjectRoute",
        "title": "Choose Trail for This Project",
        "category": "Commit Hike"
      },
      {
        "command": "commitHike.enableProject",
        "title": "Count This Project",
        "category": "Commit Hike"
      },
      {
        "command": "commitHike.disableProject",
        "title": "Stop Counting This Project",
        "category": "Commit Hike"
      },
      {
        "command": "commitHike.verify",
        "title": "Recount This Project from Git History",
        "category": "Commit Hike"
      }
    ],
    "configuration": {
      "title": "Commit Hike",
      "properties": {
        "commitHike.showDistanceAfterCommit": {
          "type": "boolean",
          "default": true,
          "description": "Briefly show the distance you gained in the status bar after each commit."
        },
        "commitHike.notifyOnWaypoints": {
          "type": "boolean",
          "default": true,
          "description": "Show a notification when you reach a new stop on your trail."
        },
        "commitHike.binaryPath": {
          "type": "string",
          "default": "",
          "description": "Path to a custom commit-hike binary. Leave empty to use the bundled one."
        }
      }
    }
  },
  "scripts": {
    "copy-core": "node scripts/copy-core.js",
    "build": "node scripts/copy-ui.js && tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "lint": "eslint src",
    "test": "npm run copy-core && npm run build && node --test out/test/*.test.js",
    "package": "npm run copy-core && npm run build && vsce package --allow-missing-repository"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.11.0",
    "@types/vscode": "~1.85.0",
    "@vscode/vsce": "^3.2.0",
    "eslint": "^9.39.5",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.70.1"
  }
}
